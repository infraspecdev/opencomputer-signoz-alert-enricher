{"version": 3, "term": {"cols": 120, "rows": 40}, "timestamp": 1791444187, "command": "opencomputer demo", "env": {"SHELL": "/bin/zsh"}, "title": "OpenComputer: SigNoz alert enricher demo"}
[0.023, "o", "\r\n\u001b[1;33m# OpenComputer demo: SigNoz alert -> agent -> Google Chat\u001b[0m\r\n"]
[2.006, "o", "\r\n\u001b[1;33m# 1. The deployed agent and its secrets (names only)\u001b[0m\r\n"]
[2.009, "o", "\u001b[1;32m$\u001b[0m opencomputer agents\r\n"]
[2.202, "o", "SigNoz Alert Enricher    default      4 deployments\r\n                         opencomputer-sample\r\n"]
[2.014, "o", "\u001b[1;32m$\u001b[0m opencomputer secrets list\r\n"]
[2.33, "o", "SIGNOZ_API_KEY               default      project                  https://signoz.gaussb.io\r\n"]
[2.042, "o", "\r\n\u001b[1;33m# 2. Break something: a pod that allocates 200Mi with a 64Mi limit\u001b[0m\r\n"]
[2.01, "o", "\u001b[1;32m$\u001b[0m kubectl --context infraspec apply -f k8s/oom-demo.yaml\r\n"]
[1.569, "o", "namespace/opencomputer-demo created\r\n"]
[0.073, "o", "pod/oom-demo created\r\n"]
[5.299, "o", "\u001b[1;32m$\u001b[0m kubectl --context infraspec -n opencomputer-demo get pod oom-demo\r\n"]
[1.116, "o", "NAME       READY   STATUS      RESTARTS   AGE\r\noom-demo   0/1     OOMKilled   0          7s\r\n"]
[2.011, "o", "\r\n\u001b[1;33m# 3. SigNoz evaluates the rule every minute, then calls the agent's webhook\u001b[0m\r\n"]
[2.018, "o", "  waiting"]
